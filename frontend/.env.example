# Copie para .env.local. Só variáveis com prefixo VITE_ chegam ao navegador:
# nunca coloque segredos aqui (a chave do Gemini fica só no backend).

# Base da API FastAPI. Vazio = mesma origem: o proxy do Vite repassa /api para http://localhost:8001.
VITE_API_BASE_URL=

# Client ID OAuth do Google Identity Services (o mesmo GOOGLE_CLIENT_ID do backend).
# Vazio esconde o botão "Fazer login com o Google"; o modo visitante continua funcionando.
VITE_GOOGLE_CLIENT_ID=
